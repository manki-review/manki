  "findings": [
    {
      "title": "A cycle with a failed DKG slot never completes, so its forged locks are never refuted",
      "file": "dash-spv/src/validation/instantlock.rs",
      "line": 86,
      "description": "The validator refutes a lock only when `cycle.complete` is true, even when the slot the lock selects already holds this cycle's own verified quorum. That quorum is never replaced, so a failed signature against it is already final. When a DKG fails, the slot keeps an older cycle's quorum for good.",
      "proof": [
        "dash-spv/src/validation/instantlock.rs:86",
        "dash-spv/src/sml_engine.rs:69",
        "dash-spv/src/sync/instantsend/manager.rs:143",
        "dash-spv/src/sync/instantsend/manager.rs:162",
        "dash-spv/src/sync/instantsend/manager.rs:183",
        "dash-spv/src/sml_engine.rs:1890",
        "dash-spv/src/validation/instantlock.rs:125-127",
        "dash-spv/src/sml_engine.rs:72-78",
        "dash-spv/src/sml_engine.rs:424-431",
        "dash-spv/src/sml_engine.rs:782-799",
        "dash-spv/src/sml_engine.rs:1890-1892",
        "dash-spv/src/sync/instantsend/manager.rs:143-146",
        "dash-spv/src/sync/instantsend/manager.rs:162-169",
        "dash-spv/src/sync/instantsend/manager.rs:179-183",
        "dash-spv/src/sync/instantsend/manager.rs:278"
      ],
      "expected": "blocker",
      "recorded": {
        "outcome": "confirmed",
        "reason": "The validator turns any signature failure into MissingQuorumData whenever `cycle.complete` is false, even when the slot the lock selects holds this cycle's own verified quorum.",
        "proof": [
          "dash-spv/src/validation/instantlock.rs:86",
          "dash-spv/src/validation/instantlock.rs:125-127"
        ],
        "base": {
          "outcome": "confirmed",
          "reason": "The base validator turns every signature failure into `InvalidSignature`, so the base refutes such a lock. The deferral to `MissingQuorumData` on an incomplete cycle is this PR's own.",
          "proof": [
            "dash-spv/src/validation/instantlock.rs:61-69"
          ]
        }
      }
    },
    {
      "title": "An unverified lock can still suppress the genuine lock for its transaction",
      "file": "dash-spv/src/sync/instantsend/manager.rs",
      "line": 162,
      "description": "A peer's undecided lock reserves its `txid` before its signature is verified. The genuine lock is then dropped before signature verification, even if its own cycle is already complete. Refuting the queued lock later does not recover the genuine lock, and queue eviction or expiry can leave the unverified cache entry behind.",
      "proof": [
        "dash-spv/src/sync/instantsend/manager.rs:143",
        "dash-spv/src/sync/instantsend/manager.rs:162",
        "dash-spv/src/sync/instantsend/manager.rs:183",
        "dash-spv/src/sync/instantsend/manager.rs:197",
        "dash-spv/src/sync/instantsend/manager.rs:205",
        "dash-spv/src/sync/instantsend/manager.rs:260",
        "dash-spv/src/sync/instantsend/manager.rs:289",
        "dash-spv/src/sync/instantsend/manager.rs:346",
        "dash-spv/src/validation/instantlock.rs:88",
        "dash-spv/src/sync/instantsend/manager.rs:145",
        "dash-spv/src/sync/instantsend/manager.rs:150",
        "dash-spv/src/sync/instantsend/manager.rs:164",
        "dash-spv/src/sync/instantsend/manager.rs:181",
        "dash-spv/src/sync/instantsend/manager.rs:196"
      ],
      "expected": "pre-existing",
      "recorded": {
        "outcome": "confirmed",
        "reason": "process_instantlock caches a lock under its txid even when verification returned MissingQuorumData (validated=false).",
        "proof": [
          "dash-spv/src/sync/instantsend/manager.rs:143",
          "dash-spv/src/sync/instantsend/manager.rs:145",
          "dash-spv/src/sync/instantsend/manager.rs:150"
        ],
        "base": {
          "outcome": "disproved",
          "reason": "The base checks `contains_key(&txid)` before verification, keeps a lock of an unknown cycle pending and caches it with `validated: false` the same way, so a later genuine lock for the txid is dropped there too.",
          "proof": [
            "dash-spv/src/sync/instantsend/manager.rs:143-146",
            "dash-spv/src/sync/instantsend/manager.rs:169-173",
            "dash-spv/src/sync/instantsend/manager.rs:186-190"
          ]
        }
      }
    },
    {
      "title": "A fresh sync discards verified older quorums that current Dash Core can still use",
      "file": "dash-spv/src/sml_engine.rs",
      "line": 789,
      "description": "When an active quorum has survived failed rotations, a fresh sync can verify its commitment but discard it because it belongs to neither the newest cycle in the tip set nor the newest cycle in the work-block list. Current Dash Core can still sign with that quorum and labels the lock with the quorum's original cycle hash. The client leaves that genuine lock undecided despite having verified its signing quorum.",
      "proof": [
        "dash-spv/src/sml_engine.rs:694",
        "dash-spv/src/sml_engine.rs:727",
        "dash-spv/src/sml_engine.rs:789",
        "dash-spv/src/sml_engine.rs:870",
        "dash-spv/src/sml_engine.rs:984",
        "dash-spv/src/sync/instantsend/manager.rs:196",
        "dash-spv/src/sml_engine.rs:797",
        "dash-spv/src/sml_engine.rs:873",
        "dash-spv/src/sml_engine.rs:997",
        "dash-spv/src/sml_engine.rs:785-793",
        "dash-spv/src/sml_engine.rs:866-876",
        "dash-spv/src/sml_engine.rs:987-989",
        "dash-spv/src/sml_engine.rs:1017-1024"
      ],
      "expected": "blocker",
      "recorded": {
        "outcome": "confirmed",
        "reason": "Only two places store a cycle: the tip set (sml_engine.rs:1019) and the work-block list at h (sml_engine.rs:727).",
        "proof": [
          "dash-spv/src/sml_engine.rs:789",
          "dash-spv/src/sml_engine.rs:797",
          "dash-spv/src/sml_engine.rs:873"
        ],
        "base": {
          "outcome": "disproved",
          "reason": "The base stores a cycle only under the cycle key of the set it verified, so a quorum that survived failed rotations is stored under no cycle hash of its own there either.",
          "proof": [
            "dash-spv/src/sml_engine.rs:743-752"
          ]
        }
      }
    },
