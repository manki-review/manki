# Manki configuration
# Place this file as .manki.yml in your repository root. Manki reads no other path.

# Automatically review PRs on open/update (default: true)
# When false, Manki reviews only on request, such as /manki review
# auto_review: true

# Auto-approve when all blocking findings are resolved and no warning
# thread holds the approval (default: true)
# Triggers on thread resolution, via /manki check, and when a draft with a
# clean review is marked ready. When off, only a review round approves.
# auto_approve: true

# The lowest repository role with which a PR author may clear a blocker or a
# security finding on their own PR: admin, maintain or write (default: maintain).
# Read from the base branch only. With `write`, everyone who can push may clear
# the blockers on their own PRs. It is also the lowest role with which anyone
# lifts the hold of a warning by resolving its thread.
# author_clear_role: maintain

# File filtering
# Defaults: the known package lockfiles that end in ".lock", such as "Cargo.lock" and
# "poetry.lock", then "dist/**" and "*.generated.*". Any other ".lock" file, such
# as ".github/workflows/actions.lock", is read. The list replaces the defaults,
# so repeat the ones you keep. [] excludes nothing.
# exclude_paths:
#   - "Cargo.lock"
#   - "dist/**"
#   - "vendor/**"

# Paths no review stage reads (default: none), such as a hidden test set. They
# are left out of the diff and deleted from the checkout the reviewer tools
# read, so not even a tool call finds them. A pattern that names a folder
# closes every file in it. Read from the base branch only. A PR that changes a
# closed file is never approved: a person must approve it.
# closed_paths:
#   - "tests/holdout/**"

# PRs that get no automatic review (default: none). Read from the base branch
# only. Labels and authors compare case-insensitively. Branches are globs on the
# head branch. Label and branch rules skip only branches in the repo itself. A skipped Manki check passes a
# required status check, so prefer skip_authors for bots: GitHub sets the author.
# skip_labels: ["dependencies"]
# skip_authors: ["dependabot[bot]"]
# skip_branches: ["dependabot/**"]

# Draft PRs (default: skip). `skip` reviews a draft only on request, such as
# `/manki review`, or after each push once Review every push is ticked on it.
# `review` reviews drafts automatically. A draft review never
# approves and does not count toward the round cap.
# drafts: skip

# Review size limits, in reviewable lines after exclude_paths, read from the
# base branch only. A PR up to auto_review_max_lines is reviewed automatically.
# A larger one gets a request to split it, with the review box in its settings block. A forced
# review covers it up to max_diff_lines. Above that Manki never reviews. A finder
# reads a diff over 1500 changed lines in slices of about that size.
# auto_review_max_lines: 8000
# max_diff_lines: 15000

# Additional instructions injected into all reviewer prompts. Name here what
# the finders should also check for, such as protocol rules.
# instructions: |
#   This is a Rust project. Focus on ownership and error handling.

# A short phrase naming what the project is (default: none). The finders read
# it as "This PR is in a blockchain consensus library project".
# project: "blockchain consensus library"

# Per-stage model selection. The finders are not here: `review.groups` below
# says who reviews.
# models:
#   planner: claude-haiku-5-5      # fast pre-review planning pass
#   judge: claude-opus-5-5         # precise, single judge
#   second_refuter: gpt-6.1-sol    # a second refuter on another model, beside the first on the judge's model (default: off, needs the Claude or Codex CLI). It also gives the origin check its second answer, which a blocker, a security finding or a changed line needs to become pre-existing
#   dedup: claude-haiku-5-5        # fast LLM dedup against prior findings
#   fallback: claude-sonnet-5-5    # reruns a stage a safety filter refused or whose model reached a limit (default: the first model of the `full` group other than the stage's own)
#
# To use OpenAI, set `openai_api_key` (or `openai_oauth_token` for Codex CLI) and override the models and the groups:
# models:
#   planner: gpt-6-luna
#   judge: gpt-6.1-sol
#   dedup: gpt-6-luna
# review:
#   groups:
#     trivial: [gpt-6.1-terra]
#     solo: [gpt-6.1-terra]
#     full: [gpt-6.1-terra, gpt-6.1-sol]
#
# To use Gemini, set `gemini_api_key` (or `gemini_oauth_token` for Gemini CLI) and override the models and the groups:
# models:
#   planner: gemini-3.5-flash-lite
#   judge: gemini-3.8-flash
#   dedup: gemini-3.5-flash-lite
# review:
#   groups:
#     trivial: [gemini-3.8-flash]
#     solo: [gemini-3.8-flash]
#     full: [gemini-3.8-flash, gemini-3-pro]
#
# Models are auto-detected by prefix: `claude-*` -> Anthropic, `gpt-*` / `o*` -> OpenAI, `gemini-*` -> Gemini.
# You can also use explicit `provider/model` syntax (e.g. `anthropic/claude-haiku-5-5`).

# The planner is a fast pre-review pass on `models.planner`. It answers three
# questions about the nature of the change: trivial (a single quick check reads
# it), subtle (finders run at high effort instead of medium) and paired (a
# second finder on another model reads it too). These are the defaults, and the
# `review` block below changes who reads what. An unclear answer takes the side
# that adds review. A diff that touches a security-sensitive path, CI, a
# dependency manifest or a data contract (migrations, SQL, protobuf, schemas,
# OpenAPI) always gets two finders.

# Judge stage. `effort` is low, medium, high, xhigh, max or auto (default),
# which takes the level the planner picks. `tool_steps` is the number of
# read-only repository tool calls the judge may make while it grades, on the
# Claude or Codex CLI (default: 0, none).
# judge:
#   effort: auto
#   tool_steps: 0

# Who reviews what. A group is a list of readers. A reader is a model id (any
# supported provider), or a map with `model`, `effort` and `focus`. A class
# matches PRs by path or by the planner's answers, and `routing` names the
# group for each class. Without this block the built-ins below apply: a quick
# check, one finder or two. Read from the base branch only, so a PR cannot
# weaken its own review. Each PR falls in the highest ranked matching class:
# security (100), supply_chain (90), data_contract (80), behavior (50, planner
# said paired), internal (30) or docs (20, planner said trivial). The first
# three are floors: at least two finders on two distinct models, none at `low`
# effort. Built-in groups: trivial (the quick check), solo (one finder) and
# full (two finders). A config that sets `groups` defines all three, and may
# add groups of its own. `full` always holds at least two finders on two
# distinct models. A class with no route goes to `full`. See
# docs/how-reviews-work.md, "Review groups".
#
# Minimal: two strong readers on security and data contract PRs only.
# review:
#   groups:
#     trivial: [claude-sonnet-5-5]                  # the quick check of a trivial change
#     solo: [claude-sonnet-5-5]                     # a low-risk change, one finder
#     full: [claude-sonnet-5-5, claude-opus-5-5]    # everything else
#     deep:
#       - { model: claude-opus-5-5, effort: high }
#       - { model: gpt-5.5, effort: high }
#   routing:
#     security: deep
#     data_contract: deep
#
# Typical:
# review:
#   groups:
#     trivial: [claude-sonnet-5-5]   # the quick check takes `model` and `effort` only, and runs at medium
#     solo: [claude-sonnet-5-5]
#     full: [claude-sonnet-5-5, gpt-6.1-terra]
#     deep:
#       - { model: claude-opus-5-5, effort: high, focus: "authz, injection, secret handling" }   # effort: low, medium, high, xhigh, max or auto (default)
#       - { model: gemini-3-pro, effort: high }
#       - { model: claude-sonnet-5-5, effort: medium, focus: "error paths and rollback" }
#   classes:
#     security:                      # adds paths to the built-in rule, never narrows it
#       match: { paths_any: ["src/billing/**"] }
#     hot_path:
#       rank: 85
#       match: { paths_any: ["src/consensus/**", "src/net/**"] }
#   routing:
#     security: deep
#     hot_path: deep
#     internal: solo
#   critical_paths: ["src/ledger/**"]   # any wrong result in these paths is severe, for the judge
#   outside_input: "HTTP requests and webhook payloads"   # for the judge
#   examples:                        # findings from this repo on each side of the bar, for the judge
#     blocker:
#       - "A rounding error in a ledger balance, however rare."
#     not_blocker:
#       - "A slow export of the monthly report: `note`."
#   sweep: off                       # search the diff for other instances of a kept finding's defect class.
#                                    # `blockers`, `warnings` or `notes` names the lowest grade that starts a search
#   notes: 3                         # how many notes a review posts as suggestions at most. 0 posts none
#   rules: auto                      # a broken required rule of your instruction files, such as
#                                    # "every migration needs a rollback", is graded by the damage it can do.
#                                    # `warn` makes it at least a warning. `block` makes it a blocker, so the PR
#                                    # is not approved until the rule is followed
#   min_warning_score: 4             # a warning rated below this importance, 1 to 10, is posted as a suggestion
#                                    # that holds no merge. 1 lowers none and skips the rating
#   scope_blocks: false              # a doubt that the PR is useful, or a proposed split of a PR that mixes
#                                    # topics, is listed in the review body. `true` posts each as a warning,
#                                    # a doubt only once the refuter confirms it, which holds the approval
#                                    # until its thread is resolved

# CI results the reviewers read as evidence (default: all on), and the
# analyzers Manki runs itself.
# Manki reads what CI reported on the PR head commit and keeps the results on
# lines of the diff. A Manki note on the same file and line
# is dropped. Warnings, blockers and security findings are kept. This block is read from the base branch,
# never from the PR, so a PR cannot turn a source off. A source the workflow
# token cannot read is skipped. See docs/how-reviews-work.md, "Reading CI results"
# and "Running Manki's analyzers".
# static_analysis:
#   checks: true             # check-run annotations, needs `checks: read`
#   code_scanning: true      # code scanning alerts, needs `security-events: read`
#   dependency_review: true  # vulnerable packages the PR adds
#   wait_for_checks: []      # check runs to wait for up to 300 seconds, such as [lint, CodeQL]
#   analyzers:               # analyzers Manki runs itself, or `all`
#     ast_grep: false        # Manki's ast-grep rules for JS, TS and Python. The Rust rules run in a Cargo repository
#     secrets: false         # gitleaks on the added lines
#     dependencies: false    # OSV-Scanner on the changed lockfiles, Cargo.lock included
#     semgrep: false         # or `rules: [...]`, your Semgrep rule files
#     actionlint: true       # on changed workflows, unless CI runs it
#     zizmor: true           # on changed workflows, unless CI runs it
#     shellcheck: true       # on changed shell scripts, unless CI runs it

# Public github.com repos the review may read as context (default: none).
# `reference`: a repo this one implements or ports. `consumer`: a repo that
# depends on this one. `dependency`: a repo this one depends on, with `ref` set
# to the version this repo pins. `ref` (branch, tag or full commit hash) and `paths` are optional.
# Read from the base branch, never from the PR. See docs/how-reviews-work.md, "Related repositories".
# related_repos:
#   - { repo: dashpay/dash, kind: reference, paths: [src/] }
#   - { repo: dashpay/platform, kind: consumer, ref: master, paths: ["packages/rs-*"] }
#   - { repo: tokio-rs/tokio, kind: dependency, ref: tokio-1.38.0, paths: [tokio/src/] }

# How rounds end. After `max_auto_rounds` automatic rounds since Manki's last
# approval, automatic review pauses until a review is started by hand, which
# turns it back on for 3 rounds. 0 turns the cap off.
# max_auto_rounds: 10

# Review memory: stores learnings and suppressions to improve reviews over time.
# With memory on, a merge also counts per severity and finder how many posted
# findings were fixed, dismissed or left untouched. The count goes to the job
# summary and to `metrics/fix-rate.jsonl` in the repo's memory.
# Without `repo`, a public repo's memory lives in the central memory repository
# and needs no token. A repo of your own needs the `memory_repo_token` input, and
# a private repo needs one that is private and has the same owner.
# memory:
#   enabled: false
#   repo: ""
